<style>
  :root {
    --bg:            #0b0d10;
    --surface:       #0d1015;
    --elevated:      #11151b;
    --text:          #e2e8f0;
    --muted:         #94a3b8;
    --dim:           #64748b;
    --border:        #1a1f26;
    --border-strong: #1f2937;
    --accent:        #a3e635;
    --accent-hover:  #bef264;
    --accent-dim:    rgba(163, 230, 53, 0.15);
    --accent-glow:   rgba(163, 230, 53, 0.35);
  }
  * { box-sizing: border-box; }
  html, body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "JetBrains Mono", "Cascadia Mono", "Consolas", ui-monospace, monospace;
    font-size: 13.5px;
    line-height: 1.55;
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--accent-dim); color: var(--text); }
  a { color: var(--accent); text-decoration: none; }
  a:hover { color: var(--accent-hover); text-decoration: underline; }

  .shell { max-width: 1400px; margin: 0 auto; padding: 0 18px 48px; }

  .topnav {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 4px;
    margin-bottom: 22px;
    border-bottom: 1px solid var(--border);
  }
  .topnav .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.01em;
  }
  .topnav .brand::before {
    content: "▌";
    color: var(--accent);
    text-shadow: 0 0 8px var(--accent-glow);
    font-size: 16px;
    line-height: 1;
  }
  .topnav .brand .name { color: var(--text); }
  .topnav .tabs { display: flex; gap: 6px; margin-left: 18px; }
  .topnav a.tab,
  .topnav > a {
    padding: 6px 12px;
    font-size: 12.5px;
    color: var(--dim);
    border: 1px solid transparent;
    border-radius: 4px;
    text-decoration: none;
  }
  .topnav a.tab:hover,
  .topnav > a:hover { color: var(--text); text-decoration: none; }
  .topnav a.tab.active,
  .topnav > a.active {
    color: var(--accent);
    border-color: var(--border-strong);
    background: var(--elevated);
  }
  .topnav .user-chip {
    margin-left: auto;
    font-size: 12px;
    color: var(--muted);
    padding: 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--elevated);
    text-decoration: none;
    transition: color .12s, border-color .12s, background .12s;
  }
  .topnav a.user-chip:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-dim);
    text-decoration: none;
  }
  .topnav .user-chip .at { color: var(--accent); margin-right: 2px; }

  .page-title {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
  }
  .page-title::before { content: "$ "; color: var(--accent); }
  .page-sub {
    margin: 0 0 22px;
    color: var(--dim);
    font-size: 12px;
  }
  .page-sub::before { content: "# "; color: #475569; }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 18px;
  }

  .field { margin-bottom: 12px; }
  .field label {
    display: block;
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 5px;
    text-transform: none;
    letter-spacing: 0;
  }
  .field label::before { content: "› "; color: var(--accent); }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 8px 10px;
    background: var(--elevated);
    border: 1px solid var(--border-strong);
    border-radius: 4px;
    color: var(--text);
    font-family: inherit;
    font-size: 12.5px;
    outline: none;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent-dim);
  }
  .field textarea { min-height: 72px; resize: vertical; }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 520px) { .grid2 { grid-template-columns: 1fr; } }

  .hint { font-size: 11px; color: var(--dim); margin-top: 4px; }

  .btn-primary {
    width: 100%;
    margin-top: 8px;
    padding: 9px 14px;
    background: transparent;
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-family: inherit;
    font-size: 12.5px;
    font-weight: 700;
    cursor: pointer;
    text-align: center;
    letter-spacing: 0.02em;
  }
  .btn-primary::before { content: "[ "; }
  .btn-primary::after { content: " ]"; }
  .btn-primary:hover { background: var(--accent-dim); color: var(--accent-hover); border-color: var(--accent-hover); }

  .alert-err {
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.35);
    color: #fca5a5;
    padding: 10px 12px;
    border-radius: 4px;
    margin-bottom: 14px;
    font-size: 12px;
  }
  .alert-err::before { content: "! "; font-weight: 700; color: #f87171; }
  .alert-ok {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 6px;
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    color: var(--text);
    text-align: center;
  }
  .alert-ok h2 { margin: 0 0 4px; font-size: 13.5px; color: var(--accent); font-weight: 700; }
  .alert-ok h2::before { content: "✓ "; }
  .alert-ok p { margin: 0 0 10px; color: var(--muted); font-size: 12px; }

  .btn-row { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .btn-row a,
  .btn-row button {
    padding: 6px 12px;
    border-radius: 4px;
    border: 1px solid var(--border-strong);
    background: var(--elevated);
    color: var(--text);
    font-family: inherit;
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .btn-row a:hover,
  .btn-row button:hover { border-color: var(--accent); color: var(--accent); }

  #invoiceHost {
    position: absolute; top: 0; left: 0;
    width: 794px; height: 1123px;
    opacity: 0; pointer-events: none; z-index: -1;
    background: #fff; overflow: hidden;
  }

  .app-footer {
    margin-top: 36px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--dim);
  }
  .app-footer .meta .ver { color: var(--muted); }
  .app-footer .tg { margin-left: auto; }
  .app-footer .tg a { color: var(--accent); }
</style>
