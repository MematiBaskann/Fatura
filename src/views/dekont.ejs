<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dekont Oluştur</title>
    <!-- Telegram WebApp Scripti -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <!-- Html2Pdf Kütüphanesi -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" crossorigin="anonymous"></script>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .dekont-paper {
            background: #ffffff;
            width: 100%;
            max-width: 600px;
            padding: 25px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            border-radius: 8px;
            margin-bottom: 20px;
        }
        h2 {
            text-align: center;
            color: #333;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            margin: 10px 0;
            border-bottom: 1px solid #eee;
            padding-bottom: 8px;
        }
        .label {
            font-weight: bold;
            color: #666;
        }
        .value {
            color: #111;
        }
        .btn-gonder {
            background-color: #2481cc;
            color: white;
            border: none;
            padding: 12px 20px;
            font-size: 16px;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
            max-width: 600px;
            font-weight: bold;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }
        .btn-gonder:hover {
            background-color: #1b659d;
        }
    </style>
</head>
<body>

    <!-- Dekontun Göründüğü Alan -->
    <div class="dekont-paper" id="dekontContent">
        <h2>Banka İşlem Dekontu</h2>
        <hr style="border: 0; border-top: 1px solid #ddd; margin-bottom: 20px;">
        <div class="info-row">
            <span class="label">İşlem Türü:</span>
            <span class="value">FAST / Havale</span>
        </div>
        <div class="info-row">
            <span class="label">Gönderen:</span>
            <span class="value">Ahmet Yılmaz</span>
        </div>
        <div class="info-row">
            <span class="label">Alıcı:</span>
            <span class="value">Mehmet Demir</span>
        </div>
        <div class="info-row">
            <span class="label">Tutar:</span>
            <span class="value" style="color: #27ae60; font-weight: bold;">1.500,00 TL</span>
        </div>
        <div class="info-row">
            <span class="label">Tarih / Saat:</span>
            <span class="value">30.08.2026 - 05:52</span>
        </div>
        <div class="info-row">
            <span class="label">İşlem No (Ref):</span>
            <span class="value">TRX98432175</span>
        </div>
    </div>

    <!-- Botla Direkt Sohbete Gönderme Butonu -->
    <button class="btn-gonder" id="pdfIndirBtn" onclick="botlaPdfGonder()">PDF'i Telegram Sohbetime Gönder 📄</button>

    <script>
        async function botlaPdfGonder() {
            const element = document.getElementById('dekontContent');
            if (!element) {
                alert('Dekont içeriği bulunamadı!');
                return;
            }

            // Telegram WebApp üzerinden kullanıcının Chat ID'sini alıyoruz
            const chatId = window.Telegram?.WebApp?.initDataUnsafe?.user?.id;
            if (!chatId) {
                alert('Bu işlem sadece Telegram içerisinden (Mini App olarak) çalışır!');
                return;
            }

            const btn = document.getElementById('pdfIndirBtn');
            btn.innerText = 'PDF Hazırlanıyor ve Gönderiliyor...';
            btn.disabled = true;

            const opt = {
                margin: 5,
                filename: 'banka-dekontu.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2, useCORS: true, logging: false },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            };

            try {
                const pdfBase64 = await html2pdf().from(element).set(opt).output('datauristring');

                const response = await fetch('/api/bot-pdf-gonder', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ chatId, pdfBase64 })
                });

                const result = await response.json();
                if (result.success) {
                    alert('PDF başarıyla Telegram sohbetinize gönderildi!');
                } else {
                    alert('Gönderilemedi: ' + (result.error || 'Bilinmeyen hata'));
                }
            } catch (err) {
                console.error('Hata:', err);
                alert('PDF oluşturulurken bir hata oluştu.');
            } finally {
                btn.innerText = "PDF'i Telegram Sohbetime Gönder 📄";
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
