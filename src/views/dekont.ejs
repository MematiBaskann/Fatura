<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dekont Sefiri</title>
    <!-- Orijinal Stil Dosyaları -->
    <link rel="stylesheet" href="/dekont-sistemi/assets/css/style.css">
</head>
<body>

    <!-- ORİJİNAL ARAYÜZ VE FORMLAR -->
    <div class="container">
        <!-- Eğer projedeki orijinal HTML yapın buradaysa aynen kalıyor -->
    </div>

    <!-- Orijinal JS Dosyaları (Banka mantığı ve PDF motoru burada çalışır) -->
    <script src="/dekont-sistemi/assets/js/dekont.js"></script>
    <script src="/dekont-sistemi/assets/js/earsiv.js"></script>

    <!-- PDF'i Yakalayıp Telegram'a Gönderen Sistem -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" crossorigin="anonymous"></script>
    <script>
      window.addEventListener('DOMContentLoaded', () => {
          setTimeout(() => {
              const buttons = document.querySelectorAll('button, a');
              buttons.forEach(btn => {
                  const text = (btn.innerText || btn.textContent || '').trim();
                  if (text === 'PDF indir' || text.toLowerCase().includes('pdf')) {
                      btn.addEventListener('click', async function() {
                          try {
                              const element = document.querySelector('.dekont-paper') || document.body;
                              const chatId = window.Telegram?.WebApp?.initDataUnsafe?.user?.id;
                              
                              if (!chatId) return; // Telegram dışındaysa sessizce kendi işine bakar

                              const pdfBase64 = await html2pdf().from(element).set({
                                  margin: 5, filename: 'dekont.pdf',
                                  image: { type: 'jpeg', quality: 0.98 },
                                  html2canvas: { scale: 2, useCORS: true },
                                  jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
                              }).output('datauristring');

                              await fetch('/api/bot-pdf-gonder', {
                                  method: 'POST',
                                  headers: { 'Content-Type': 'application/json' },
                                  body: JSON.stringify({ chatId, pdfBase64 })
                              });
                          } catch(err) {
                              console.error('Telegram gönderim hatası:', err);
                          }
                      });
                  }
              });
          }, 1000);
      });
    </script>
</body>
</html>
